{
  "sourceLanguage" : "en",
  "strings" : {
    "adapter.session.bundleIntegrityFailed" : {
      "comment" : "Integrity check failure when opening an installed adapter.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installed adapter failed its integrity check: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adapter installato non ha superato il controllo di integrità: %@"
          }
        }
      }
    },
    "adapter.session.invalidBundleEncoding" : {
      "comment" : "The installed adapter bundle is not valid UTF-8.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installed adapter is not valid UTF-8"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adapter installato non è UTF-8 valido"
          }
        }
      }
    },
    "adapter.session.unsupportedAPIVersion" : {
      "comment" : "The adapter was built for a newer contract version.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsupported adapter API version %lld; expected %lld"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versione API dell'adapter non supportata: %lld; attesa %lld"
          }
        }
      }
    },
    "site.error.adapterNotInstalled" : {
      "comment" : "No adapter with this identifier is installed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No installed adapter named %@. Install it from Settings → Adapters."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun adapter installato con nome %@. Installalo da Impostazioni → Adapter."
          }
        }
      }
    },
    "site.error.catalogUnavailable" : {
      "comment" : "Cross-site browsing is not configured.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Site browsing is unavailable"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La navigazione dei siti non è disponibile"
          }
        }
      }
    },
    "site.error.challengeRequired" : {
      "comment" : "The site asks the user to complete a verification page.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The site requires a verification before continuing: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sito richiede una verifica prima di continuare: %@"
          }
        }
      }
    },
    "site.error.chapterFetchFailed" : {
      "comment" : "The chapter request returned a non-success HTTP status.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chapter page returned HTTP %lld"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pagina del capitolo ha restituito HTTP %lld"
          }
        }
      }
    },
    "site.error.duplicatePageIndex" : {
      "comment" : "The adapter returned two pages with the same index.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The adapter returned duplicate page index %lld"
