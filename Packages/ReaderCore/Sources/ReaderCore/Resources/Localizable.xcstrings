        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adapter ha restituito l'indice di pagina duplicato %lld"
          }
        }
      }
    },
    "site.error.invalidPageURL" : {
      "comment" : "The adapter returned a page URL the app refuses to load.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The adapter returned an invalid page URL: %@"
