{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits",
      "mergeCommitPatterns": ["^feat!.*release v\\d+"]
    }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogTitle": "# Changelog" }],
    ["@semantic-release/exec", { "prepareCmd": "bash scripts/set-version.sh ${nextRelease.version}" }],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "assets": [
          { "path": "release/BlankGrimoire.ipa", "label": "BlankGrimoire.ipa" },
          { "path": "release/BlankGrimoire.dSYM.zip", "label": "BlankGrimoire.dSYM.zip" }
        ]
      }
    ]
  ]
}