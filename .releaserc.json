{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogTitle": "# Changelog" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "bash scripts/release-prepare.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "project.yml"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "assets": [
          {
            "path": "release/BlankGrimoire.xcarchive.zip",
            "label": "BlankGrimoire.xcarchive.zip"
          },
          {
            "path": "release/BlankGrimoire.dSYM.zip",
            "label": "BlankGrimoire.dSYM.zip"
          },
          {
            "path": "release/SHA256SUMS",
            "label": "SHA256SUMS"
          }
        ]
      }
    ]
  ]
}
